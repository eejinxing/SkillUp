<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SkillUp.Master.cs" Inherits="SKILL_UP.Frontend.SkillUpMaster" %>
<!doctype html>
<html lang="en">
<head id="Head1" runat="server">
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0c0e12"><title>Skill UP</title>
<link rel="stylesheet" href="css/styles.css"><link rel="stylesheet" href="css/design-alignment.css"><link rel="stylesheet" href="css/role-completion.css"><link rel="stylesheet" href="css/visitor-home.css"><link rel="stylesheet" href="css/learner-dashboard.css"><link rel="stylesheet" href="css/enroll-page.css"><link rel="stylesheet" href="css/answer-page.css"><link rel="stylesheet" href="css/my-courses.css"><link rel="stylesheet" href="css/chat-page.css"><link rel="stylesheet" href="css/leaderboard.css"><link rel="stylesheet" href="css/instructor-dashboard.css"><link rel="stylesheet" href="css/quiz-editor.css"><link rel="stylesheet" href="css/student-performance.css"><link rel="stylesheet" href="css/course-editor.css"><link rel="stylesheet" href="css/course-requests.css"><link rel="stylesheet" href="css/admin-dashboard.css"><link rel="stylesheet" href="css/admin-users.css"><link rel="stylesheet" href="css/user-editor.css"><link rel="stylesheet" href="css/leader-dashboard.css"><link rel="stylesheet" href="css/program-management.css"><link rel="stylesheet" href="css/leader-applications.css"><link rel="stylesheet" href="css/ui-refinement.css"><link rel="stylesheet" href="css/home-refinement.css"><link rel="stylesheet" href="css/secondary-views.css"><link rel="stylesheet" href="css/dashboard-components.css"><link rel="stylesheet" href="css/learning-console.css"><link rel="stylesheet" href="css/learning-console-v2.css"><link rel="stylesheet" href="css/auth-refinement.css"><link rel="stylesheet" href="css/home-dashboard.css"><link rel="stylesheet" href="css/my-courses-v2.css"><link rel="stylesheet" href="css/home-reference.css"><link rel="stylesheet" href="css/admin-dashboard-polish.css"><link rel="stylesheet" href="css/instructor-polish.css"><link rel="stylesheet" href="css/leader-polish.css"><link rel="stylesheet" href="css/course-requests-polish.css"><link rel="stylesheet" href="css/chat-polish.css"><link rel="stylesheet" href="css/course-detail-polish.css"><link rel="stylesheet" href="css/requests-grid.css"><link rel="stylesheet" href="css/performance-blocks.css"><link rel="stylesheet" href="css/admin-users-market.css"><link rel="stylesheet" href="css/leader-board.css"><link rel="stylesheet" href="css/chat-perfect.css"><link rel="stylesheet" href="css/leaderboard-v2.css"><link rel="stylesheet" href="css/leader-perfect.css"><link rel="stylesheet" href="css/menubar.css"><link rel="stylesheet" href="css/answer-skill.css"><link rel="stylesheet" href="css/workspace-nav.css"><link rel="stylesheet" href="css/call-reference.css"><link rel="stylesheet" href="css/profile-page.css"><link rel="stylesheet" href="css/call-polish.css"><link rel="stylesheet" href="css/home-footer.css"><link rel="stylesheet" href="css/call-polish-2.css"><link rel="stylesheet" href="css/call-polish-3.css"><link rel="stylesheet" href="css/catalog-polish.css"><link rel="stylesheet" href="css/answer-companion.css"><link rel="stylesheet" href="css/home-enquiry.css"><link rel="stylesheet" href="css/leaderboard-timing.css"><link rel="stylesheet" href="css/leaderboard-skill.css"><link rel="stylesheet" href="css/learner-pills.css"><link rel="stylesheet" href="css/learner-orbit.css"><link rel="stylesheet" href="css/staff-refine.css"><link rel="stylesheet" href="css/learner-velo.css"><link rel="stylesheet" href="css/webforms.css"><link rel="stylesheet" href="css/responsive.css">
<asp:ContentPlaceHolder ID="PageHead" runat="server" />
</head>
<body id="SkillBody" runat="server">
<form id="SkillForm" runat="server">
<a class="skip" href="#main">Skip to content</a>
<div id="app">
<asp:Literal ID="ShellOpen" runat="server" />
<header class="skill-global-header">
  <a class="gn-brand" href="<%= Page.Me == null ? "Home" : "Dashboard" %>" aria-label="Skill UP home"><img class="skill-logo" src="assets/skill-logo.png" alt="Skill UP" width="930" height="420"></a>
  <div class="gn-capsule">
    <span class="gn-workspace-label"><%= Page.Me == null ? "Explore Skill UP" : "Your workspace" %></span>
    <span class="gn-date"><%= DateTime.Now.ToString("d MMM", System.Globalization.CultureInfo.GetCultureInfo("en-GB")) %></span>
    <nav class="gn-links" aria-label="Main navigation">
      <asp:Repeater ID="NavLinks" runat="server"><ItemTemplate><a href="<%# Eval("Url") %>"<%# (bool)Eval("Current") ? " aria-current=\"page\"" : "" %>><%#: Eval("Label") %></a></ItemTemplate></asp:Repeater>
    </nav>
    <div class="gn-call-strip" aria-live="off"></div>
  </div>
  <div class="gn-actions">
    <asp:PlaceHolder ID="GuestActions" runat="server">
      <a href="#login" class="gn-guest" aria-label="Log in or sign up" title="Log in or sign up"><span class="avatar gn-guest-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span></a>
      <a href="#register" class="gn-register">Sign up</a>
    </asp:PlaceHolder>
    <asp:PlaceHolder ID="UserActions" runat="server">
      <%-- Temporary call preview triggers (js/call-preview.js). Remove with SHOW_INCOMING_CALL_TEST there. --%>
      <button type="button" class="gn-demo-call" data-call-test="" title="Temporary: simulate an incoming video meeting">Test video call</button>
      <button type="button" class="gn-demo-call gn-demo-voice" data-call-test="voice" title="Temporary: simulate an incoming voice call">Receive call</button>
      <a href="Profile" aria-label="Your profile"><%= Page.Me == null ? "" : Ui.Avatar(Page.Me) %></a>
    </asp:PlaceHolder>
  </div>
</header>
<main id="main" runat="server" clientidmode="Static">
  <asp:ContentPlaceHolder ID="PageContent" runat="server" />
  <asp:PlaceHolder ID="RestrictedPanel" runat="server" Visible="false"><div class="empty"><h3>Access restricted</h3><p>This page belongs to a different role.</p></div></asp:PlaceHolder>
</main>
<%-- The landing page footer, shown to visitors on every page. --%>
<skill:SiteFooter ID="VisitorFooter" runat="server" />
<%-- Log in and Sign up pop-ups for visitors: a link to #login or #register opens one over the page. --%>
<asp:PlaceHolder ID="AuthDialogs" runat="server">
<skill:LoginDialog ID="LoginPopup" runat="server" />
<skill:RegisterDialog ID="RegisterPopup" runat="server" />
<span id="close" hidden></span>
</asp:PlaceHolder>
<asp:Literal ID="ShellClose" runat="server" />
</div>
<div id="toast" role="status" aria-live="polite"<%= Notice == null ? "" : " class=\"visible\"" %>><%: Notice %></div>
</form>
<%-- Back to top: js/site.js shows it once the page is scrolled. --%>
<button type="button" class="scroll-top" data-scroll-top="" aria-label="Back to top" title="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button>
<script src="js/site.js" defer></script>
<asp:PlaceHolder ID="CallScript" runat="server"><script type="application/json" id="call-context"><%= CallContext %></script><script src="js/call-preview.js" defer></script></asp:PlaceHolder>
<asp:ContentPlaceHolder ID="PageScripts" runat="server" />
</body>
</html>
