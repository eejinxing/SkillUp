<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to secrets.config (same folder as Web.config) and fill in your values.
  secrets.config is ignored by git, so the key is never committed. Restart the site after changing it.
  Get a free key at https://aistudio.google.com/apikey
-->
<appSettings>
  <add key="Gemini:ApiKey" value="PASTE-YOUR-KEY-HERE" />
</appSettings>
