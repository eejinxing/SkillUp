# Visual Studio: per-user settings, caches and IIS Express config (.vs/)
.vs/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# Secrets: the Gemini API key lives here (copy secrets.config.example)
secrets.config

# Build output and NuGet packages (restored on build)
bin/
obj/
packages/

# ASP.NET precompiled site output (Publish, or aspnet_compiler)
PrecompiledWeb/

# SQL Server LocalDB database files (App_Data). Each teammate creates theirs with Database/setup-db.ps1.
*.mdf
*.ldf

# Publish: per-user profile settings and downloaded publish settings (contain deploy credentials)
*.pubxml.user
*.publishsettings

# Course covers uploaded in the course editor (Frontend/uploads/course-art)
Frontend/uploads/

# Local test tools and their output (not part of the site)
node_modules/
npm-debug.log*
Frontend/previews/
Frontend/.test-output/

# OS and Office temporary files
Thumbs.db
desktop.ini
~$*

# Local Claude Code permissions
.claude/settings.local.json
