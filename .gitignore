# Build output and NuGet packages (restored on build)
bin/
obj/
packages/

# ASP.NET precompiled site output (Publish, or aspnet_compiler)
PrecompiledWeb/

# SQL Server LocalDB database files (App_Data). Each teammate builds theirs with Database/create-tables.sql.
*.mdf
*.ldf

# Publish: per-user profile settings and downloaded publish settings (contain deploy credentials)
*.pubxml.user
*.publishsettings

