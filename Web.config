<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <connectionStrings>
    <!-- App_Data/SkillUp.mdf. Read it in C# with ConfigurationManager.ConnectionStrings["SkillUp"].ConnectionString -->
    <add name="SkillUp" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\SkillUp.mdf;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings file="secrets.config">
    <!-- Keys that must not be committed (Gemini:ApiKey) go in secrets.config next to this file; see secrets.config.example. -->
    <!-- Learning companion: Gemini model. The API key is Gemini:ApiKey in secrets.config (or the GEMINI_API_KEY environment variable). Without a key the companion gives sample replies. -->
    <add key="Gemini:Model" value="gemini-3.5-flash-lite" />
    <!-- Development switches for the Skill UP API (Backend/Security.cs). Web.Release.config sets both to false. -->
    <!-- Load Database/demo-seed.json (demo accounts, courses) into an empty database on first start. -->
    <add key="SkillUp:SeedDemoData" value="true" />
    <!-- No email service yet: show the password reset link on screen. -->
    <add key="SkillUp:ShowResetLink" value="true" />
    <!-- Validator controls use the classic built-in script, so pages do not load jQuery. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <!-- Pages and controls are saved as UTF-8 (without a byte order mark when edited outside Visual Studio). -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- 8 MB so a 2 MB course file (about 2.8 MB as base64 JSON) fits. -->
    <httpRuntime targetFramework="4.8.1" maxRequestLength="8192" enableVersionHeader="false" />
    <!-- Cookies (including the session cookie) are hidden from scripts and are not sent on cross-site posts. Web.Release.config also requires HTTPS. -->
    <httpCookies httpOnlyCookies="true" sameSite="Lax" />
    <sessionState cookieSameSite="Lax" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
        <add namespace="SKILL_UP.Frontend" />
        <add namespace="SKILL_UP.Backend" />
      </namespaces>
      <controls>
        <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
        <add tagPrefix="skill" tagName="AuthArt" src="~/Frontend/Controls/AuthArt.ascx" />
        <add tagPrefix="skill" tagName="EnquiryForm" src="~/Frontend/Controls/EnquiryForm.ascx" />
        <add tagPrefix="skill" tagName="SiteFooter" src="~/Frontend/Controls/SiteFooter.ascx" />
        <add tagPrefix="skill" tagName="LoginDialog" src="~/Frontend/Controls/LoginDialog.ascx" />
        <add tagPrefix="skill" tagName="RegisterDialog" src="~/Frontend/Controls/RegisterDialog.ascx" />
        <add tagPrefix="skill" tagName="CourseCard" src="~/Frontend/Controls/CourseCard.ascx" />
        <add tagPrefix="skill" tagName="CourseHero" src="~/Frontend/Controls/CourseHero.ascx" />
        <add tagPrefix="skill" tagName="CourseFiles" src="~/Frontend/Controls/CourseFiles.ascx" />
        <add tagPrefix="skill" tagName="TerminalLab" src="~/Frontend/Controls/TerminalLab.ascx" />
        <add tagPrefix="skill" tagName="LearnerTable" src="~/Frontend/Controls/LearnerTable.ascx" />
        <add tagPrefix="skill" namespace="SKILL_UP.Frontend.Controls" assembly="SKILL UP" />
      </controls>
    </pages>
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- Browsers must not guess file types, show the site inside another site's frame, or send full page addresses to other sites. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), payment=(), usb=()" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- Font files never change under the same name: browsers keep them for a week instead of asking again on every page. -->
  <location path="Frontend/assets/visitor">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="Frontend/assets/registered">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>