@model AccountController.ForgotModel
<div class="auth-screen">
<div id="dialog" class="auth-dialog" data-auth="forgot" role="dialog" aria-modal="true" aria-labelledby="dialog-title">
  <a class="dialog-close" href="/Home" aria-label="Close">&times;</a>
  <div class="auth-v2 auth-modal auth-forgot">
    <partial name="_AuthArt" model="@("forgot")" />
    <section class="auth-form">
      <div class="auth-card">
        <h2 id="dialog-title">Reset your password</h2>
        @switch (Model.Step)
        {
          case 0:
            <p class="auth-modal-sub">Enter the email you registered with. In this demo, the reset link appears on screen.</p>
            <form method="post" asp-antiforgery="true" action="/ForgotPassword">
              <div class="auth-control">
                <div class="auth-label-row"><label for="AuthEmail">Email <b class="req" title="Required" aria-hidden="true">*</b></label></div>
                <span class="auth-field"><input id="AuthEmail" name="email" type="email" value="@Ctx.Typed("email")" required placeholder="The email you registered with" autocomplete="email" /></span>
              </div>
              <p class="form-error" role="alert">@Ctx.Notice</p>
              <div class="actions"><button class="primary" type="submit">Send reset link</button></div>
            </form>
            break;
          case 1:
            <p class="auth-modal-sub">This prototype does not send email. Use the link below within 15 minutes.</p>
            <div class="actions"><a class="button primary" href="@Model.ResetUrl">Choose a new password</a></div>
            break;
          default:
            <p class="auth-modal-sub">If that email belongs to an account, a reset link is on its way. It stays valid for 15 minutes.</p>
            break;
        }
        <p class="auth-switch">Remembered your password? <a class="link" href="#login">Log in</a></p>
      </div>
    </section>
  </div>
</div>
</div>
