@model SkillUp.Models.InstructorDashboardModel
<section class="instructor-dashboard">
  <h1 id="page-title" class="id-sr-only" tabindex="-1">Instructor dashboard</h1>
  <nav class="id-rail" aria-label="Instructor quick navigation">@(Model.Rail)</nav>
  <div class="id-main">
    <div class="id-metrics">
      <section class="id-metric id-enrolled">
        <img class="id-metric-surface" src="/assets/instructor/283-2114-imgIncomeNeonGreenBarChart.svg" alt="">
        <header><h2>Enrolled learners</h2><a class="id-income-menu" href="/Learners" aria-label="View all enrolled learners">@Html.Raw(InstructorDashboardModel.More)</a></header>
        <div class="id-figure"><strong class="id-big">@(Model.Learners)</strong><span class="id-delta">@((Model.NewLearners > 0 ? "+" : "") + Model.NewLearners)</span></div>
        <p class="id-metric-note">Compared to @(Model.StartCount) a month ago &middot; @(Model.EnrolmentCount) enrolments</p>
        <div class="id-enrolment-chart" role="img" aria-label="Learning sessions by your learners per day, last 30 days">@(Model.DailyBars)</div>
        <div class="id-chart-axis">@(Model.Axis)</div>
      </section>
      <section class="id-metric id-completion">
        <h2>Course completion</h2>
        <strong class="id-big id-mono">@(Model.Completion)%</strong>
        <p class="id-metric-note">@(Model.Completed) of @(Model.EnrolmentCount) enrolments completed</p>
        <figure class="id-area-wrap"><span class="id-area-badge">@(Model.GrowthBadge)</span>@(Model.CumulativeChart)<figcaption>Learner sessions, cumulative &middot; last 30 days</figcaption></figure>
      </section>
      <section class="id-metric id-quiz">
        <h2>Average Quiz Score</h2>
        <div class="id-quiz-figure"><span class="id-big id-mono">@(Model.QuizAverage == null ? "—" : Model.QuizAverage + "%")</span><small>@(Ui.Plural(Model.QuizCount, "graded quiz attempt"))</small></div>
        <figure class="id-area-wrap">@(Model.QuizChart)<figcaption>Practice quiz average &middot; 7-day rolling</figcaption></figure>
        <a href="/Analytics" class="id-quiz-link">View assessment analytics</a>
      </section>
    </div>
    <section class="id-workspace">
      <header class="id-workspace-header">
        <nav aria-label="Teaching workspace"><a href="/Dashboard" class="active" aria-current="page">My Courses</a></nav>
        <a class="id-create-course" href="/CourseEditor"><img src="/assets/instructor/283-870-imgCiAddPlusCircle.svg" alt="">Create Course</a>
      </header>
      <div class="id-program-scroll" tabindex="0" aria-label="Courses grouped by program">
        <div class="id-program-grid">
          @foreach (dynamic p in Model.ProgramList)
{
<section class="id-program">
                <h2>@p.Name</h2>
                <div class="id-program-meta"><span class="id-program-people">@Html.Raw(p.FirstLearner)<b>@p.LearnerCount</b></span><a href="/CourseEditor?program=@p.Id">&#65291; New Course</a></div>
                <div class="id-course-grid">@Html.Raw(p.CardsHtml)</div>
              </section>
}
          @if (Model.NoCourses)
{<div class="id-empty"><h2>No courses assigned yet</h2><p>Create your first course and submit it for Program Leader review.</p><a href="/CourseEditor" class="button">Create a course</a></div>}
        </div>
      </div>
    </section>
  </div>
</section>
