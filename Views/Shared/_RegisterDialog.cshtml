@* The Sign up form as a pop-up. The layout puts it on every visitor page; it opens over the page when the address ends in #register.
   Model: true on the Register page itself, which shows it open and closes to the landing page. *@
@model bool
@{
    var closeUrl = Model ? "/Home" : "#close";
    var loginUrl = Model ? "/Login" : "#login";
    // Register?email= (the footer's sign-up box) fills in the email.
    var email = Ctx.Typed("email", Ctx.Query("email"));
    var instructor = Ctx.Typed("role") == "Instructor";
}
<div class="auth-popup@(Model ? " is-open" : "")" id="register">
<div class="auth-screen">
  <a class="auth-backdrop" href="@closeUrl" tabindex="-1" aria-hidden="true"></a>
<div id="register-dialog" class="auth-dialog" data-auth="register" role="dialog" aria-modal="true" aria-labelledby="register-title">
  <a class="dialog-close" href="@closeUrl" aria-label="Close">&times;</a>
  <div class="auth-v2 auth-modal auth-register">
    <partial name="_AuthArt" model="@("register")" />
    <section class="auth-form">
      <div class="auth-card">
        <h2 id="register-title">Create your account</h2>
        <p class="auth-modal-sub">Instructor accounts are reviewed before they can publish courses.</p>
        <form class="auth-fields" method="post" asp-antiforgery="true" action="/Register">
          <input type="hidden" name="fromPage" value="@(Model ? "register" : "")">
          <div class="form-grid">
          <div class="auth-control">
            <div class="auth-label-row"><label for="SignUpName">Full name <b class="req" title="Required" aria-hidden="true">*</b></label></div>
            <span class="auth-field"><input id="SignUpName" name="name" value="@Ctx.Typed("name")" required placeholder="Alex Morgan" autocomplete="name" /></span>
          </div>
          <div class="auth-control">
            <div class="auth-label-row"><label for="SignUpUsername">Username <b class="req" title="Required" aria-hidden="true">*</b></label></div>
            <span class="auth-field"><input id="SignUpUsername" name="username" value="@Ctx.Typed("username")" required placeholder="alexmorgan" autocomplete="username" /></span>
          </div>
          </div>
          <div class="auth-control">
            <div class="auth-label-row"><label for="SignUpEmailBox">Email <b class="req" title="Required" aria-hidden="true">*</b></label></div>
            <span class="auth-field"><input id="SignUpEmailBox" name="email" type="email" value="@email" required placeholder="you@example.com" autocomplete="email" /></span>
          </div>
          <fieldset class="auth-role">
            <legend>I&rsquo;m joining to</legend>
            <div class="auth-role-options">
              <label><input type="radio" name="role" value="Learner" checked="@(!instructor)" /><span><strong>Learn</strong><small>Take courses and track progress</small></span></label>
              <label><input type="radio" name="role" value="Instructor" checked="@instructor" /><span><strong>Teach</strong><small>Publish courses after approval</small></span></label>
            </div>
          </fieldset>
          <div class="form-grid">
          <div class="auth-control">
            <div class="auth-label-row"><label for="SignUpPassword">Password <b class="req" title="Required" aria-hidden="true">*</b></label></div>
            <span class="auth-field"><input id="SignUpPassword" name="password" type="password" required minlength="8" maxlength="128" placeholder="8+ characters" autocomplete="new-password" /><button type="button" class="auth-eye" data-auth-eye="" aria-label="Show password"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span>
          </div>
          <div class="auth-control">
            <div class="auth-label-row"><label for="SignUpConfirm">Confirm password <b class="req" title="Required" aria-hidden="true">*</b></label></div>
            <span class="auth-field"><input id="SignUpConfirm" name="confirm" type="password" required placeholder="Type it again" autocomplete="new-password" /><button type="button" class="auth-eye" data-auth-eye="" aria-label="Show password"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span>
          </div>
          </div>
          <div class="pw-help" data-pw-for="SignUpPassword">
            <div class="pw-meter" role="progressbar" aria-label="Password strength" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0"><i></i><i></i><i></i><i></i></div>
            <p class="pw-label" aria-live="polite">Password strength: <b>not entered yet</b></p>
            <ul class="pw-rules">
              <li data-rule="length">8 to 128 characters</li>
              <li data-rule="capital">A capital letter (A&ndash;Z)</li>
              <li data-rule="number">A number (0&ndash;9)</li>
              <li data-rule="special">A special character (! @@ # $ %)</li>
            </ul>
          </div>
          <div class="auth-control auth-terms">
            <label class="auth-check"><input type="checkbox" id="AgreeTerms" name="agree" value="true" required /><span>I agree to the <a href="/Terms" target="_blank" rel="noopener">Terms of use</a> and the <a href="/Privacy" target="_blank" rel="noopener">Privacy information</a> <b class="req" title="Required" aria-hidden="true">*</b></span></label>
          </div>
          <p class="form-error" role="alert">@(Model ? Ctx.Notice : null)</p>
          <div class="actions"><button class="primary" type="submit">Create account</button></div>
        </form>
        <p class="auth-switch">Already have an account? <a class="link" href="@loginUrl">Log in</a></p>
      </div>
    </section>
  </div>
</div>
</div>
</div>
