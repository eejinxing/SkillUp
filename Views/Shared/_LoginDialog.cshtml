@* The Log in form as a pop-up. The layout puts it on every visitor page; it opens over the page when the address ends in #login.
   Model: true on the Login page itself, which shows it open and closes to the landing page. *@
@model bool
@{
    var closeUrl = Model ? "/Home" : "#close";
    var registerUrl = Model ? "/Register" : "#register";
    // Signing in goes to ?return= (a page that asked for it), back to this page, or to the dashboard.
    var returnUrl = Ctx.Query("return");
    if (string.IsNullOrEmpty(returnUrl) || !returnUrl.StartsWith('/') || returnUrl.StartsWith("//"))
    {
        returnUrl = Ctx.Page.StayAfterSignIn ? Context.Request.Path + Context.Request.QueryString : "/Dashboard";
    }
}
<div class="auth-popup@(Model ? " is-open" : "")" id="login">
<div class="auth-screen">
  <a class="auth-backdrop" href="@closeUrl" tabindex="-1" aria-hidden="true"></a>
<div id="login-dialog" class="auth-dialog" data-auth="login" role="dialog" aria-modal="true" aria-labelledby="login-title">
  <a class="dialog-close" href="@closeUrl" aria-label="Close">&times;</a>
  <div class="auth-v2 auth-modal auth-login">
    <partial name="_AuthArt" model="@("login")" />
    <section class="auth-form">
      <div class="auth-card">
        <h2 id="login-title">Log in</h2>
        <p class="auth-modal-sub">Use your email or username to open your workspace.</p>
        <form class="auth-fields" method="post" asp-antiforgery="true" action="/Login">
          <input type="hidden" name="returnUrl" value="@returnUrl">
          <div class="auth-control">
            <div class="auth-label-row"><label for="LoginUser">Email or username <b class="req" title="Required" aria-hidden="true">*</b></label></div>
            <span class="auth-field"><input id="LoginUser" name="user" value="@Ctx.Typed("user")" required placeholder="you@example.com" autocomplete="username" /></span>
          </div>
          <div class="auth-control">
            <div class="auth-label-row"><label for="LoginPassword">Password <b class="req" title="Required" aria-hidden="true">*</b></label><a class="auth-inline-link" href="/ForgotPassword">Forgot password?</a></div>
            <span class="auth-field"><input id="LoginPassword" name="password" type="password" required placeholder="Your password" autocomplete="current-password" /><button type="button" class="auth-eye" data-auth-eye="" aria-label="Show password"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></span>
          </div>
          <p class="form-error" role="alert">@(Model ? Ctx.Notice : null)</p>
          <div class="actions"><button class="primary" type="submit">Log in</button></div>
        </form>
        <p class="auth-switch">New to Skill UP? <a class="link" href="@registerUrl">Create an account</a></p>
      </div>
    </section>
  </div>
</div>
</div>
</div>
