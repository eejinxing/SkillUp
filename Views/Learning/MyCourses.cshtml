@model SkillUp.Models.MyCoursesModel
@if (Model.Selected == null) {
<section class="my-courses mc-empty">
  <h1 id="page-title" tabindex="-1"><img class="mc-pixel-title" src="/assets/my-courses/my-course-pixel.png" alt="My course"></h1>
  <h2>No programs available yet</h2>
  <p>Your learning programs will appear here once published.</p>
  <a href="/Catalog" class="button">Explore courses</a>
</section>
} else {
<section class="my-courses">
  <header class="mc-page-header"><h1 id="page-title" tabindex="-1"><img class="mc-pixel-title" src="/assets/my-courses/my-course-pixel.png" alt="My course"></h1></header>
  <div class="mc-layout">
    <aside class="mc-programs" aria-label="Programs">
      <div class="mc-program-scroll" role="tablist" aria-label="Choose a program" aria-orientation="vertical">
        @{ var p_index = -1; }
@foreach (dynamic p in Model.ProgramTabs)
{
p_index++;
<div class="mc-program" data-selected="@Html.Raw((bool)p.Selected ? "true" : "false")" data-kit="@Html.Raw((bool)p.Enrolled ? "open" : (bool)p.HasCourses ? "closed" : "empty")"@Html.Raw((bool)p.JustOpened ? " data-just-opened=\"true\"" : "")>
              <a class="mc-program-link" id="mc-tab-@Html.Raw(p_index)" role="tab" aria-selected="@Html.Raw((bool)p.Selected ? "true" : "false")" aria-controls="mc-courses-panel" href="/MyCourses?program=@p.Id" aria-label="@p.Name@Html.Raw((bool)p.Enrolled ? ", enrolled" : ", not enrolled")"><img src="/assets/my-courses/skillup-kit-@((bool)p.Enrolled ? "open" : "closed").jpg" alt=""><span class="mc-program-caption">@p.Name</span></a>
              @Html.Raw((bool)p.Enrolled ? "<span class=\"mc-program-cta is-enrolled\" aria-hidden=\"true\"><span class=\"mc-cta-label\">Enrolled</span><span class=\"mc-cta-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg></span></span>" : "")
              @if (!(bool)@p.Enrolled) { <form method="post" asp-antiforgery="true" action="/MyCourses/Enroll" style="display:contents"><input type="hidden" name="program" value="@p.Id"><button class="mc-program-cta" type="submit" aria-label="Enroll in @p.Name">' CommandArgument='@p.Id' OnCommand="EnrolProgram_Command" aria-label='@Html.Raw("Enroll in " + p.Name)'><span class="mc-cta-label">Enroll</span><span class="mc-cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 4.5 20 12 4.5 19.5 7.5 12Z"/><path d="M7.5 12H13"/></svg></span></button></form> }
            </div>
}
      </div>
    </aside>
    <section class="mc-courses-panel" id="mc-courses-panel" role="tabpanel">
      <header class="mc-panel-header"><div><small>Selected program</small><h2 id="mc-program-title">@(Model.Selected.Name)</h2></div></header>
      <div class="mc-course-scroll" tabindex="0" aria-label="Courses in @(Model.Selected.Name)">
        @{ var c_index = -1; }
@foreach (dynamic c in Model.CourseList)
{
c_index++;
<article class="mc-course" data-course-id="@c.Id">
              <div class="mc-course-metrics">
                <div class="mc-course-index"><span class="mc-number">@Html.Raw((c_index + 1).ToString("00"))</span></div>
                <div class="mc-course-gauge">@Html.Raw(c.Ring)</div>
              </div>
              <a class="mc-course-art" href="/Course?id=@c.Id&amp;from=mycourses" aria-label="View course: @c.Title"><img src="@c.Art" alt="" loading="eager"></a>
              <section class="mc-course-summary" aria-label="@c.Title progress">
                <div class="mc-market-accent">
                  <div class="mc-market-marks" aria-hidden="true"><span><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5h6c1 0 1.5 1 1.5 1S13 5 14 5h5v14h-5c-1 0-1.5 1-1.5 1s-.5-1-1.5-1H5Z"/><path d="M12.5 6v14"/></svg></span><span><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 12 4 4 8-8"/></svg></span></div>
                  <strong>@c.Percent<sup>%</sup></strong><p>Completed</p>
                </div>
                <div class="mc-market-main">
                  <header><h3>@c.Title</h3><div class="mc-market-tags"><span>@c.Status</span><span>@c.Done/@c.Lessons</span></div></header>
                  <p class="mc-market-subtitle">@c.Difficulty &middot; @c.Lessons activities</p>
                  <p class="mc-market-date"><span>Due date</span><time>@c.Due</time></p>
                  <footer>
                    <a href="/Course?id=@c.Id&amp;from=mycourses" class="mc-market-details" aria-label="Course details: @c.Title"><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="4" height="4" rx="1"/><rect x="15" y="5" width="4" height="4" rx="1"/><rect x="5" y="15" width="4" height="4" rx="1"/><rect x="15" y="15" width="4" height="4" rx="1"/></svg></a>
                    <a class="mc-market-action" href="@c.Href" aria-label="@c.Action: @c.Title" title="@c.Action"><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
                  </footer>
                </div>
              </section>
            </article>
}
        @if (Model.NoCourses)
{<div class="mc-empty"><h2>No courses here yet</h2><p>Published courses for this program will appear here.</p><a class="button" href="/Catalog">Explore courses</a></div>}
      </div>
    </section>
  </div>
</section>
}
<script src="/js/pack-opening.js" defer></script>
