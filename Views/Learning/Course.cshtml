@model SkillUp.Models.CourseModel
@if (Model.IsUnavailable)
{
  <div class="empty"><h3>Course unavailable</h3><p>This course is not currently open for enrolment.</p></div>
}
@if (!Model.IsUnavailable)
{
<article class="course-enroll" data-course-id="@(Model.C.Id)">
  <nav class="ce-breadcrumb" aria-label="Course navigation">
    <a href="@(Model.BackUrl)" class="ce-back"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>@(Model.BackLabel)</a>
    <span aria-hidden="true">/</span><span>@(Model.C.Title)</span>
    @if (Me?.Role == "Learner") {<a href="/Dashboard" class="ce-dashboard-link">My dashboard</a>}
  </nav>
  <header class="ce-banner">
    <partial name="_CourseHero" />
    <div class="ce-banner-copy">
      <p class="ce-banner-program">@(Model.ProgramName)</p>
      <h1>@(Model.C.Title)</h1>
      <p class="ce-banner-desc">@(Model.C.Description)</p>
      <ul class="ce-banner-facts">
        <li><span>Level</span>@(Model.C.Difficulty)</li>
        <li><span>Activities</span>@(Model.Lessons.Count)</li>
        <li><span>Learning time</span>@(Model.TotalMinutes) min</li>
        <li><span>Rating</span>@(Model.Rating == null ? "New" : "&#9733; " + Model.Rating)</li>
      </ul>
    </div>
  </header>
  <div class="ce-content">
    <div class="ce-main">
      <section class="ce-about">
        <h2>About this course</h2>
        <p class="ce-course-name">@(Model.C.Title)</p>
        <p>Build practical skills through @(Model.Lessons.Count) guided activities taught by @(Model.InstructorName). Read the explanations, practise what you learn and check your understanding in the assessments.</p>
        <details class="ce-show-more">
          <summary><span class="ce-more-label">Show more</span><span class="ce-less-label">Show less</span></summary>
          <p>@(Model.C.Description)</p>
          <p>Complete activities in order. Pass each quiz with at least 70% to complete the course and earn your certificate.</p>
        </details>
      </section>
      <section class="ce-outcomes">
        <h2>What you will learn</h2>
        <ul>
          @{ var o_index = -1; }
@foreach (dynamic o in Model.Outcomes)
{
o_index++;
<li><span class="ce-tick"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>@(o)</li>
}
        </ul>
      </section>
      <section class="ce-curriculum">
        <div class="ce-section-heading"><h2>Course curriculum</h2><small>@(Model.Lessons.Count) activities &middot; @(Model.TotalMinutes) min@(Model.Enrollment != null ? " &middot; " + Model.Completed.Count + " completed" : "")</small></div>
        @if (Model.Enrollment != null) {<div class="ce-curriculum-progress" role="progressbar" aria-label="Course progress" aria-valuenow="@(Model.Percent)" aria-valuemin="0" aria-valuemax="100"><i style="width:@(Model.Percent)%"></i></div>}
        <div class="ce-lesson-list">
          @{ var l_index = -1; }
@foreach (dynamic l in Model.Curriculum)
{
l_index++;
<details class="ce-lesson" data-lesson-id="@l.Id" data-state="@l.State">
                <summary>
                  <span class="ce-lesson-index">@Html.Raw((string)l.State == "done" ? "<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>" : l.Number)</span>
                  <span class="ce-lesson-copy"><span class="ce-lesson-title">@l.Title</span><span class="ce-lesson-meta">@l.Type &middot; @l.Minutes min</span></span>
                  <span class="ce-lesson-state">@Html.Raw((string)l.State == "locked" ? "<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"7\" width=\"9\" height=\"6.5\" rx=\"1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/></svg>" : "")@l.Label</span>
                  <span class="ce-chevron"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </summary>
                <div class="ce-lesson-body">
                  <div><p>@l.Note</p>@Html.Raw(l.PreviewHtml)</div>
                  <div>@Html.Raw(l.ActionHtml)</div>
                </div>
              </details>
}
          @if (Model.NoLessons)
{<p class="ce-course-empty">The instructor is preparing the course activities.</p>}
        </div>
      </section>
      @if (Model.ShowFiles) { <partial name="_CourseFiles" model="@((int?)Model.C.Id)" /> }
      <section class="ce-course-information">
        <h2 class="ce-info-title">Course details</h2>
        <div class="ce-info-grid">
          <div class="ce-info-card"><h3>Requirements</h3><ul><li>@(Model.C.Difficulty == "Beginner" ? "No prior experience required" : "Basic familiarity with the subject")</li><li>A computer with internet access</li><li>A code editor and a curious mind</li></ul></div>
          <div class="ce-info-card"><h3>Who this course is for</h3><ul><li>Students building practical tech skills</li><li>Learners exploring @(Model.C.Title)</li><li>Anyone ready to learn by doing</li></ul></div>
          <div class="ce-info-card"><h3>This course includes</h3><ul class="ce-includes"><li>@(Model.Lessons.Count) guided activities</li><li>@(Model.TotalMinutes) minutes of learning content</li><li>Completion certificate</li><li>70% quiz pass mark</li></ul></div>
          <div class="ce-info-card"><h3>Tags</h3><div class="ce-tags"><span>@(string.IsNullOrEmpty(Model.C.Icon) ? "Tech" : Model.C.Icon)</span><span>@(Model.C.Difficulty)</span><span>@(Model.ProgramName)</span></div></div>
        </div>
      </section>
    </div>
    <aside class="ce-sidebar">
      <section class="ce-enrol-card">
        <small>@(Model.Enrollment != null ? "Your course progress" : Model.CanManage ? "You manage this course" : "Start your next chapter")</small>
        <strong>@(Model.Enrollment != null ? Model.Percent + "% complete" : Model.CanManage ? Model.C.Status : "Free enrolment")</strong>
        @if (Model.Enrollment != null) {<div class="ce-enrol-progress" aria-hidden="true"><i style="width:@(Model.Percent)%"></i></div>}
        @if (Model.ActionText != null) { <a class="ce-enrol-button" href="@Model.ActionUrl">@Model.ActionText</a> }
        @if (Model.ShowEnrol) { <form method="post" asp-antiforgery="true" action="/Course/Enrol"><input type="hidden" name="id" value="@Model.C.Id"><button class="ce-enrol-button" type="submit">Enrol in course</button></form> }
        <p>@(Model.Enrollment != null ? Model.Completed.Count + " of " + Model.Lessons.Count + " activities completed" : Model.CanManage ? "Edit activities, files and quizzes from the course editor." : "All course activities included &middot; Learn at your own pace")</p>
        @if (Me == null) {<a class="ce-create-account" href="#register">Create a free account</a>}
        <dl>
          <div><dt>Level</dt><dd>@(Model.C.Difficulty)</dd></div>
          <div><dt>Duration</dt><dd>@(Model.C.Duration) weeks</dd></div>
          <div><dt>Deadline</dt><dd>@(Ui.Date(Model.C.Deadline))</dd></div>
          <div><dt>Enrolled learners</dt><dd>@(Model.LearnerCount)</dd></div>
        </dl>
      </section>
      <section class="ce-instructors">
        <h2>Your instructor</h2>
        <div>@(Ui.Avatar(Model.Instructor))<span><strong>@(Model.InstructorName)</strong><small>Instructor</small></span></div>
        <p>@(string.IsNullOrWhiteSpace(Model.Instructor?.Bio) ? "Practical lessons and guided learning." : Model.Instructor.Bio)</p>
        @if (Me != null && Me.Id != Model.C.InstructorId && Model.Instructor != null) {<a class="ce-instructor-link" href="/Messages?id=@(Model.Instructor.Id)">Send a message</a>}
      </section>
    </aside>
  </div>
  <section class="ce-reviews" aria-label="Learner reviews" id="course-reviews">
    <aside class="ce-rating">
      <h2>Learner reviews<span>across @(Model.AllReviews ? "Skill UP" : Model.C.Title)</span></h2>
      <strong class="ce-average">&#9733; @(Model.ReviewAverage)</strong>
      <p>@(Ui.Plural(Model.Reviews.Count, "review")) &middot; @(Model.AllReviews ? "all courses" : "this course")</p>
      <div class="ce-rating-bars">
        @{ var b_index = -1; }
@foreach (dynamic b in Model.RatingBars)
{
b_index++;
<div><span>@b.Label</span><meter min="0" max="100" value="@b.Percent" aria-label="@b.Aria"></meter><small>@b.Rounded%</small></div>
}
      </div>
      @if (Model.WriteReview)
{
        <details class="ce-review-form">
          <summary class="ce-review-write">Write a review</summary>
          <form class="stack" method="post" asp-antiforgery="true" action="/Course/Review"><input type="hidden" name="id" value="@Model.C.Id">
            <label>Rating
              <select id="ReviewRating" name="rating">@foreach (var n in new[] { "5", "4", "3", "2", "1" }) { <option value="@n" selected="@(Model.MyRating == n)">@n</option> }</select>
            </label>
            <label>Your experience
              <textarea id="ReviewText" name="text" rows="4" maxlength="2000">@Model.MyText</textarea>
              </label>
            <button class="primary" type="submit">Save review</button>
          </form>
        </details>
      }
    </aside>
    <div class="ce-review-list">
      <div class="ce-review-toolbar">
        <h3>@(Ui.Plural(Model.Reviews.Count, "review"))</h3>
        <label class="ce-filter"><span class="sr-only">Filter learner reviews</span>
          <select form="scope-form" id="ReviewScope" name="scope"  onchange="this.form.submit()"><option value="course" selected="@((Model.AllReviews ? "all" : "course") == "course")">This course</option><option value="all" selected="@((Model.AllReviews ? "all" : "course") == "all")">All courses</option></select><form id="scope-form" method="get" action="/Course"><input type="hidden" name="id" value="@Model.C.Id"></form>
        </label>
      </div>
      @{ var r_index = -1; }
@foreach (dynamic r in Model.ReviewList)
{
r_index++;
<article class="ce-review" data-review-id="@r.Id">
            <div class="ce-review-identity">@Html.Raw(r.AvatarHtml)<strong>@r.Author</strong></div>
            <div class="ce-review-copy">
              <h3>Course: @r.Course</h3>
              <p class="ce-review-stars"><span class="ce-stars" aria-label="@r.Rating out of 5 stars">@Html.Raw(r.Stars)</span> <span>@r.Rating.0 &middot; Reviewed on @r.Date</span></p>
              <p class="ce-review-text">@r.Text</p>
            </div>
            @foreach (dynamic x in r.Replies)
{
<div class="ce-thread">@Html.Raw(x.AvatarHtml)<div><div class="ce-reply-name"><strong>@x.Author</strong><span>@x.Role</span></div><small>@x.Date &middot; Replying to @x.To</small><p>@x.Text</p></div></div>
}
            @if ((bool)r.CanReply)
{
<details class="ce-reply-form"><summary>Reply</summary><form class="stack" method="post" asp-antiforgery="true" action="/Course/Reply"><input type="hidden" name="reviewId" value="@r.Id"><input type="hidden" name="id" value="@Model.C.Id"><textarea name="text" rows="3" maxlength="2000" placeholder="Write a reply" aria-label="Write a reply" required></textarea><button class="primary" type="submit">Post reply</button></form></details>
}
          </article>
}
      @if (Model.NoReviews)
{<div class="ce-no-reviews"><h3>No reviews yet</h3><p>Be the first to share what you learned.</p></div>}
    </div>
  </section>
</article>
}
