@model SkillUp.Models.AssistantModel
<div class="page-head page-intro"><div><h1 tabindex="-1" id="page-title">Ask your AI Assistant</h1><p>A nudge, an explanation or an example for any activity, any time.</p></div><div class="actions tight"></div></div>
  <div class="split assistant-split">
    <script>(function (split) { var zoom = parseFloat(getComputedStyle(document.documentElement).zoom) || 1, h = innerHeight / zoom; split.classList.toggle('is-short', h < 800); split.classList.toggle('is-tiny', h < 660); })(document.currentScript.parentElement);</script>
    <div class="answer-page assistant-stage">
      <aside class="answer-ai answer-ai-reference assistant-companion @(Model.HasChat ? "has-conversation" : "")" aria-label="AI Assistant" data-api="/api/commands/" data-lesson="@(Model.SelectedLesson)">
        <header class="answer-ai-top">
          <a href="/Assistant" class="answer-ai-brand" aria-label="Skill UP companion">SKILL<span>companion</span></a>
          <span class="answer-ai-where">@(Model.WhereText)</span>
          <details class="answer-ai-options"><summary aria-label="Companion options"><span aria-hidden="true">&bull;&bull;&bull;</span></summary><div>@if (Model.ChatLessonUrl != null) {<a href="@(Model.ChatLessonUrl)">Open activity &#8599;</a>} else {<a href="/MyCourses">My courses &#8599;</a>}</div></details>
        </header>
        <div class="answer-ai-intro">
          <div class="answer-orb"><img src="/assets/answer/imgRectangle4.png" alt="Blue and violet AI companion orb"></div>
          <h2><span>Your next <em>big</em></span> <span><em>move</em> starts here.</span></h2>
        </div>
        <div class="answer-ai-conversation" aria-live="polite">
          @foreach (var pair in Model.HistoryList)
{
<div class="answer-ai-prompt"><span class="ai-avatar">@Ui.Avatar(Me)</span><small>You &middot; @Ui.ChatTime(pair.PromptAt)</small><p>@pair.Prompt</p></div><div class="answer-ai-reply"><span class="ai-avatar bot" aria-hidden="true"></span><small>Skill UP companion &middot; @Ui.ChatTime(pair.ResponseAt)</small><p>@pair.Response</p></div>
}
        </div>
        <div class="answer-ai-bottom">
          <div class="answer-ai-books" aria-hidden="true">
            <div class="answer-ai-book"><small>SKILL UP</small><b>Your next<br>chapter.</b><i></i></div>
            <div class="answer-ai-book"><small>PRACTICE</small><b>Learn.<br>Try. Repeat.</b><i></i></div>
            <div class="answer-ai-book"><small>FIELD NOTES</small><b>Make it<br>click.</b><i></i></div>
          </div>
          <div class="answer-ai-suggest" role="group" aria-label="Suggested questions">
            @foreach (dynamic s in Model.Suggestions)
{
<button type="button" data-question="@s.Question"><span>@s.Title</span><small>@s.Detail</small></button>
}
          </div>
          <form class="answer-ai-composer" method="post" asp-antiforgery="true" action="/Assistant/Ask"><input type="hidden" name="lesson" value="@Model.SelectedLesson">
            <div class="answer-ai-input-wrap">
              @if (Model.HasContext) { <button type="button" class="answer-ai-add" data-question="@Model.ContextQuestion" aria-label="Ask about this activity" title="Ask about this activity"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg></button> }
              <label class="sr-only" for="AskBox">Ask your learning companion</label>
              <input id="AskBox" name="text" type="text"  autocomplete="off" placeholder="Curious? Let’s explore together" maxlength="2000" />
            </div>
            <button type="submit" class="answer-ai-send" aria-label="Send question"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></button>
            <p class="form-error" role="alert"></p>
          </form>
        </div>
      </aside>
    </div>
    <aside class="assistant-convos" aria-label="Conversations">
      <h2 class="assistant-label">Conversations</h2>
      <label class="assistant-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="sr-only">Find a conversation</span><input type="search" placeholder="Find a conversation…" autocomplete="off" aria-label="Find a conversation" data-conversation-search></label>
      <nav class="assistant-convo-list" aria-label="Your conversations">@(Model.ConversationsHtml)</nav>
      <p class="assistant-nomatch" hidden>No conversations match.</p>
      <p class="assistant-note">@(Companion.Configured ? "The companion is powered by AI and can make mistakes, so check anything important." : "Demo companion: responses come from simple templates on the server.") Your questions are saved in your account&rsquo;s history.</p>
    </aside>
  </div>
