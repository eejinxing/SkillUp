   "id": "c1",
   "title": "MongoDB Management",
   "programId": "p1",
   "instructorId": "u2",
   "difficulty": "Intermediate",
   "status": "Published",
   "description": "Model, query and manage real application data. Build confidence with documents, CRUD operations and aggregation pipelines.",
   "outcomes": "Design collections and documents\nWrite efficient queries and aggregation pipelines\nUnderstand indexes and database performance",
   "deadline": "2026-11-20",
   "duration": 4,
   "color": "mint",
   "icon": "DB",
   "lessons": [
    {
     "id": "l1",
     "title": "Documents & collections",
     "type": "article",
     "body": "MongoDB stores data as flexible documents. A collection groups related documents, like a table groups rows. A document can contain nested objects and arrays.\nExample: { name: \"Alex\", skills: [\"MongoDB\", \"C#\"] }.\nChoose a structure that reflects how your application reads data.",
     "answer": "",
     "minutes": 15,
     "preview": true
    },
    {
     "id": "l2",
     "title": "Find your first document",
     "type": "lab",
     "body": "Use the users collection to find a document with the name Alex. Complete the command: db.users.____({ name: \"Alex\" }). Enter the missing method.",
     "answer": "findOne",
     "starterCode": "db.users.____({ name: \"Alex\" })",
     "minutes": 25,
     "preview": false
    },
    {
     "id": "l3",
     "title": "Aggregation pipelines",
     "type": "article",
     "body": "An aggregation pipeline processes documents in stages. $match filters documents; $group summarises them; $sort orders results.\nPlace selective filters early to reduce the amount of data passed to later stages.",
     "answer": "",
     "minutes": 15,
     "preview": true
    },
    {
     "id": "l4",
     "title": "Knowledge check",
     "type": "quiz",
     "body": "Check your understanding of MongoDB documents and pipelines.",
     "answer": "",
     "minutes": 25,
     "preview": false
    }
   ],
